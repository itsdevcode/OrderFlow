APP_NAME="OrderFlow API"
APP_VERSION="1.0.0"
# Local Docker defaults only. Replace both signing secrets for any deployment.
DEBUG=false
JWT_SECRET_KEY="local_only_jwt_key_change_before_deployment"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Compose creates this role/database only when its PostgreSQL volume is empty.
POSTGRES_DB=orderflow
POSTGRES_USER=orderflow_user
POSTGRES_PASSWORD=local_only_password
# URL credentials must match POSTGRES_*; percent-encode reserved URL characters.
# Containers use service DNS. For host execution, override to localhost and
# expose services separately; default Compose publishes only the API.
DATABASE_URL=postgresql+asyncpg://orderflow_user:local_only_password@postgres:5432/orderflow
REDIS_URL=redis://redis:6379/0
API_PORT=8000
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
TEST_REDIS_URL=redis://localhost:6379/1

# Redis is shared by caching and rate limiting; either consumer keeps its pool enabled.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REFRESH_LIMIT=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_WEBHOOK_LIMIT=120
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
# JSON array of explicit proxy IPs/CIDRs. Keep empty for direct connections.
RATE_LIMIT_TRUSTED_PROXIES=[]

# Application JSON logging (no SQL parameter echo, even with DEBUG=true).
LOG_LEVEL=INFO
# Best-effort anonymous failed-login audit transaction deadline.
AUDIT_FAILURE_TIMEOUT_SECONDS=1.0

# Integration test database (destructive fixtures; never use production).
TEST_DATABASE_URL=postgresql+asyncpg://orderflow_user:orderflow_password@localhost:5432/orderflow_test
PAYMENT_WEBHOOK_SECRET=local_only_webhook_key_change_before_deployment
